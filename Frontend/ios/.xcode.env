# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY: path to node. Xcode may not have your shell PATH; use .xcode.env.local
# to set a full path. Run `which node` in Terminal and put that path in .xcode.env.local.
if [ -z "$NODE_BINARY" ]; then
  export NODE_BINARY=$(command -v node 2>/dev/null || true)
fi
if [ -z "$NODE_BINARY" ]; then
  for path in /opt/homebrew/bin/node /usr/local/bin/node; do
    [ -x "$path" ] && export NODE_BINARY=$path && break
  done
fi
