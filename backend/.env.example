PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=chitrakal
DB_USER=postgres
DB_PASSWORD=your_db_password

# Admin panel JWT (required in production; use a long random string)
ADMIN_JWT_SECRET=
# Optional token lifetime (default 7d)
# ADMIN_JWT_EXPIRES=7d
# First workspace admin (created only if no row exists for this username)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose_a_strong_password
# Alias: ADMIN_BOOTSTRAP_PASSWORD (same as ADMIN_PASSWORD if set)
# ADMIN_BOOTSTRAP_PASSWORD=
# DESIGNER_BOOTSTRAP_PASSWORD=
# CREATIVE_HEAD_BOOTSTRAP_PASSWORD=   # user creative_head (created on startup if missing)

# Firebase Admin configuration (choose one method)
# 1) Path to service account JSON file:
FIREBASE_SERVICE_ACCOUNT_PATH=
# 2) Raw JSON content as one line:
FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) Base64-encoded JSON content:
FIREBASE_SERVICE_ACCOUNT_BASE64=
