PORT=3000
# production: enables strict JWT, CORS_ORIGINS, OTP rules, disables Firebase test-mode
NODE_ENV=development
# TRUST_PROXY=1
# OTP_PROVIDER=firebase

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=chitrakal
DB_USER=postgres
DB_PASSWORD=your_db_password

# --- Admin JWT (REQUIRED in production: min 32 chars, high entropy) ---
ADMIN_JWT_SECRET=
# Optional token lifetime (default 7d)
# ADMIN_JWT_EXPIRES=7d

# First workspace admin (created only if no row exists for this username)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose_a_strong_password
# ADMIN_BOOTSTRAP_PASSWORD=
# DESIGNER_BOOTSTRAP_PASSWORD=
# CREATIVE_HEAD_BOOTSTRAP_PASSWORD=

# --- OTP for mobile (/api/auth/send-otp, verify-otp) ---
# firebase (default in production): no server SMS; app must use Firebase Phone Auth + verify-firebase-otp
# sms: Twilio sends 6-digit codes (requires vars below)
# dev (default in non-production): random OTP in memory; set LOG_DEV_OTP=1 to print code in logs
OTP_PROVIDER=

# Twilio (required when OTP_PROVIDER=sms)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# Or use a Messaging Service instead of From:
# TWILIO_MESSAGING_SERVICE_SID=

# Rate limits (optional overrides)
# RATE_LIMIT_OTP_SEND_WINDOW_MS=900000
# RATE_LIMIT_OTP_SEND_MAX=5
# RATE_LIMIT_OTP_VERIFY_WINDOW_MS=900000
# RATE_LIMIT_OTP_VERIFY_MAX=30
# RATE_LIMIT_ADMIN_LOGIN_MAX=20
# RATE_LIMIT_FIREBASE_PHONE_MAX=30

# --- CORS (production) ---
# Comma-separated exact origins (no trailing slashes). Requests with no Origin (mobile apps) still work.
# Example (Indipix admin): IP:8443 now, subdomain later — include http and https if you use both.
# CORS_ORIGINS=https://64.227.150.214:8443,http://dashboard.indipix.in,https://dashboard.indipix.in
CORS_ORIGINS=

# Behind nginx/load balancer: set so rate limits see client IP
# TRUST_PROXY=1

# --- Dev only: bypass Firebase with test-mode (never in production) ---
# ALLOW_FIREBASE_TEST_MODE=1
# LOG_DEV_OTP=1

# --- Firebase Admin (server) ---
FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
